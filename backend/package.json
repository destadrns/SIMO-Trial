{
  "name": "simo-mugi-jaya-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch server --ext js,sql --exec \"node --env-file-if-exists=.env server/index.js\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --test server/tests/api.test.js",
    "test:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --test server/tests/api.test.js",
    "db:seed": "node --env-file-if-exists=.env server/seed/seedDatabase.js",
    "db:migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "db:backup:help": "node -e \"console.log('Use docs/BACKUP_RESTORE.md for pg_dump/pg_restore commands.')\"",
    "test:security": "node --env-file-if-exists=.env --test server/tests/securityRegression.test.js",
    "smtp:verify": "node --env-file-if-exists=.env server/scripts/smtp.js",
    "smtp:test": "node --env-file-if-exists=.env server/scripts/smtp.js --send-test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "redis": "^6.1.0",
    "simo-mugi-jaya": "file:.."
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
